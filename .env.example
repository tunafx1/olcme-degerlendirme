# ==============================================================================
# Sınav Analiz ve Raporlama Sistemi — Ortam Değişkenleri Şablonu (.env)
# ==============================================================================

# --- FIREBASE YAPILANDIRMASI ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="proje-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="proje-id"
VITE_FIREBASE_STORAGE_BUCKET="proje-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# --- YAPAY ZEKÂ (AI) API ANAHTARLARI ---
# Google Gemini API Anahtarı (Google AI Studio: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=""
VITE_GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Anahtarı (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=""
VITE_OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude API Anahtarı (https://console.anthropic.com/)
VITE_CLAUDE_API_KEY=""
VITE_CLAUDE_MODEL="claude-3-5-sonnet-20241022"
